import time

class Person:
    def __init__(self, name: str, phone: int, program: str, nid: int):
        self.name = name
        self._nid = nid  # protected variable
        self.phone = phone
        self.faculty = "Faculty of Commerce and Business Administration"
        self.program = program
        self.semester = "Second Semester"
        self.year = "2026"

    def display_account_details(self):
        print(f"""
        {"="*50}
        |               ACCOUNT DETAILS                 |
        {"="*50}
        | Name:        {self.name}
        | National ID: {self._nid}
        | Phone:       {self.phone}
        | Faculty:     {self.faculty}
        | Program:     {self.program}
        | Semester:    {self.semester}
        | Year:        {self.year}
        {"="*50}
        """)

class Doctor(Person):
    def __init__(self, nid: int, name="", phone=None, program="", code="", course="", salary=0):
        super().__init__(name, phone, program, nid)
        self.code = code
        self.course = course
        self.salary = salary
        self.hours_worked = 0

    def display_doctor_details(self):
        print(f"""
        {"="*50}
        |            DOCTOR ACCOUNT DETAILS             |
        {"="*50}
        | Name:        {self.name}
        | Phone:       {self.phone}
        | Code:        {self.code}
        | National ID: {self._nid}
        | Program:     {self.program}
        | Year:        {self.year}
        {"="*50}
        """)

    def check_course(self):
        print(f"-> The courses you currently teach: {self.course}")

    def add_course(self, new_course: str):
        print(f"-> Course before update: {self.course}")
        self.course = new_course
        print(f"-> Course added successfully! New course: {self.course}")

    def check_hours_worked(self):
        print(f"-> Your worked hours: {self.hours_worked} hours")

    def add_hours_worked(self, hours: int):
        self.hours_worked = hours
        print(f"-> Worked hours updated to: {self.hours_worked} hours")

    def check_salary(self, base_salary: float):
        self.salary = base_salary
        if self.hours_worked > 30:
            overtime_hours = self.hours_worked - 30
            # حساب الأوفر تايم بناءً على قيمة الساعة من الراتب الأساسي مفترضين 30 ساعة أساسية
            overtime_amount = overtime_hours * (self.salary / 30)
            net_salary = self.salary + overtime_amount
            print(f"-> Net base salary: {self.salary} EGP")
            print(f"-> Salary after adding overtime ({overtime_hours} hrs): {net_salary:.2f} EGP")
        else:
            print(f"-> Your net salary is: {self.salary} EGP (No overtime)")

class Student(Person):
    def __init__(self, nid: int, name="", phone=None, program="", student_id=None, university_email=None):
        super().__init__(name, phone, program, nid)
        self.university_email = university_email
        self.student_id = student_id

    # Getter & Setter للتحكم في الـ National ID بأمان
    @property
    def nid(self):
        return self._nid

    @nid.setter
    def nid(self, new_id: int):
        if len(str(new_id)) >= 5:  # شرط بسيط كمثال للتحقق
            self._nid = new_id
            print("-> National ID updated successfully!")
        else:
            print("-> Invalid National ID format!")

    def display_student_details(self):
        print(f"""
        {"="*50}
        |            STUDENT ACCOUNT DETAILS            |
        {"="*50}
        | Name:             {self.name}
        | Phone:            {self.phone}
        | Program:          {self.program}
        | Semester:         {self.semester}
        | Student ID:       {self.student_id}
        | University Email: {self.university_email}
        | Year:             {self.year}
        {"="*50}
        """)


