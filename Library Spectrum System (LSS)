# ================= HELPER FUNCTIONS =================
def refresh_book_display():
    """Update the book text area with current book list"""
    book_text.delete(1.0, END)
    if not books:
        book_text.insert(END, "No books in the library.\n")
        return
    display = "=" * 80 + "\n"
    display += f"{'ID':<5} {'Title':<25} {'Author':<20} {'Publisher':<20}\n"
    display += "=" * 80 + "\n"
    for b in books:  # loop is allowed for data processing, not for widget creation
        display += f"{b['id']:<5} {b['title']:<25} {b['author']:<20} {b['publisher']:<20}\n"
        display += f"   Price: ${b['price']:.2f} | Year: {b['year']} | Category: {b['category']}\n"
    display += "=" * 80
    book_text.insert(END, display)

def refresh_borrowed_display():
    """Update the borrowed book text area with current borrowed list"""
    borrowed_text.delete(1.0, END)
    if not borrowed_books:
        borrowed_text.insert(END, "No borrowed book records.\n")
        return
    display = "=" * 100 + "\n"
    display += f"{'ID':<4} {'Borrower':<15} {'Book Title':<25} {'Author':<15} {'Period':<8} {'Overdue':<8} {'Fee/Day':<10}\n"
    display += "=" * 100 + "\n"
    for b in borrowed_books:  # loop for data display, allowed
        display += f"{b['id']:<4} {b['borrower_name']:<15} {b['book_title']:<25} {b['author']:<15} "
        display += f"{b['borrowing_period']:<8} {b['overdue_days']:<8} ${b['late_fee_per_day']:<9.2f}\n"
        display += f"   Borrow: {b['borrow_date']} | Return: {b['return_date']} | Publisher: {b['publisher']}\n"
    display += "=" * 100
    borrowed_text.insert(END, display)

# ================= BOOK SUBSYSTEM FUNCTIONS =================
def add_book():
    title = entry_book_title.get()
    author = entry_book_author.get()
    publisher = entry_book_publisher.get()
    price_str = entry_book_price.get()
    year_str = entry_book_year.get()
    category = entry_book_category.get()

    if not title or not author:
        messagebox.showerror("Error", "Book Title and Author are required!")
        return

    try:
        price = float(price_str) if price_str else 0.0
    except:
        messagebox.showerror("Error", "Price must be a number!")
        return

    try:
        year = int(year_str) if year_str else 0
    except:
        messagebox.showerror("Error", "Year must be a number!")
        return

    # Generate new ID
    new_id = 1
    if books:
        new_id = max(b['id'] for b in books) + 1

    book = {
        "id": new_id,
        "title": title,
        "author": author,
        "publisher": publisher,
        "price": price,
        "year": year,
        "category": category
    }
    books.append(book)
    messagebox.showinfo("Success", f"Book '{title}' added with ID: {new_id}")
    clear_add_book_entries()
    refresh_book_display()
    show_book()

def clear_add_book_entries():
    entry_book_title.delete(0, END)
    entry_book_author.delete(0, END)
    entry_book_publisher.delete(0, END)
    entry_book_price.delete(0, END)
    entry_book_year.delete(0, END)
    entry_book_category.delete(0, END)

def edit_book_id():
    curr_id_str = entry_curr_id.get()
    new_id_str = entry_new_id.get()
    if not curr_id_str or not new_id_str:
        messagebox.showerror("Error", "Both Current ID and New ID are required!")
        return
    try:
        curr_id = int(curr_id_str)
        new_id = int(new_id_str)
    except:
        messagebox.showerror("Error", "IDs must be numbers!")
        return

    # Find book
    book_to_edit = None
    for b in books:
        if b['id'] == curr_id:
            book_to_edit = b
            break
    if not book_to_edit:
        messagebox.showerror("Error", f"No book found with ID: {curr_id}")
        return
    if any(b['id'] == new_id for b in books):
        messagebox.showerror("Error", f"ID {new_id} already exists!")
        return

    book_to_edit['id'] = new_id
    messagebox.showinfo("Success", f"Book ID changed from {curr_id} to {new_id}")
    clear_edit_id_entries()
    refresh_book_display()
    show_book()

def clear_edit_id_entries():
    entry_curr_id.delete(0, END)
    entry_new_id.delete(0, END)

def display_books():
    refresh_book_display()

# ================= BORROWED BOOK SUBSYSTEM FUNCTIONS =================
def add_borrowed_book():
    title = entry_borrowed_title.get()
    author = entry_borrowed_author.get()
    publisher = entry_borrowed_publisher.get()
    borrower = entry_borrower_name.get()
    borrow_date = entry_borrow_date.get()
    return_date = entry_return_date.get()
    period_str = entry_borrowing_period.get()
    overdue_str = entry_overdue_days.get()
    fee_str = entry_late_fee.get()

    if not title or not author or not borrower:
        messagebox.showerror("Error", "Book Title, Author, and Borrower Name are required!")
        return

    try:
        period = int(period_str) if period_str else 0
        overdue = int(overdue_str) if overdue_str else 0
        fee = float(fee_str) if fee_str else 0.0
    except:
        messagebox.showerror("Error", "Period, Overdue Days must be integers, Late Fee must be a number!")
        return

    new_id = 1
    if borrowed_books:
        new_id = max(b['id'] for b in borrowed_books) + 1

    borrowed = {
        "id": new_id,
        "book_title": title,
        "author": author,
        "publisher": publisher,
        "borrower_name": borrower,
        "borrow_date": borrow_date,
        "return_date": return_date,
        "borrowing_period": period,
        "overdue_days": overdue,
        "late_fee_per_day": fee
    }
    borrowed_books.append(borrowed)
    messagebox.showinfo("Success", f"Borrowed record added with ID: {new_id}")
    clear_add_borrowed_entries()
    refresh_borrowed_display()
    show_borrowed()

def clear_add_borrowed_entries():
    entry_borrowed_title.delete(0, END)
    entry_borrowed_author.delete(0, END)
    entry_borrowed_publisher.delete(0, END)
    entry_borrower_name.delete(0, END)
    entry_borrow_date.delete(0, END)
    entry_return_date.delete(0, END)
    entry_borrowing_period.delete(0, END)
    entry_overdue_days.delete(0, END)
    entry_late_fee.delete(0, END)

def display_borrowed_books():
    refresh_borrowed_display()

def edit_borrowing_period():
    borrower = entry_edit_borrower.get()
    title = entry_edit_title.get()
    new_period_str = entry_new_period.get()
    if not borrower or not title or not new_period_str:
        messagebox.showerror("Error", "Borrower Name, Book Title, and New Period are required!")
        return
    try:
        new_period = int(new_period_str)
    except:
        messagebox.showerror("Error", "Period must be a number!")
        return

    found = False
    for b in borrowed_books:
        if b['borrower_name'].lower() == borrower.lower() and b['book_title'].lower() == title.lower():
            b['borrowing_period'] = new_period
            found = True
            break
    if not found:
        messagebox.showerror("Error", f"No borrowed record found for '{borrower}' and book '{title}'")
        return
    messagebox.showinfo("Success", f"Borrowing period updated to {new_period} days")
    clear_edit_period_entries()
    refresh_borrowed_display()
    show_borrowed()

def clear_edit_period_entries():
    entry_edit_borrower.delete(0, END)
    entry_edit_title.delete(0, END)
    entry_new_period.delete(0, END)

def check_borrower_details():
    borrower = entry_check_borrower.get()
    if not borrower:
        messagebox.showerror("Error", "Please enter a borrower name")
        return
    # Find all borrowed records for this borrower
    records = [b for b in borrowed_books if b['borrower_name'].lower() == borrower.lower()]
    if not records:
        borrowed_text.delete(1.0, END)
        borrowed_text.insert(END, f"No borrowing records found for borrower: {borrower}\n")
        return

    display = "=" * 80 + "\n"
    display += f"BORROWER DETAILS: {borrower}\n"
    display += "=" * 80 + "\n\n"
    for rec in records:
        display += f"--- Borrowed Book Record (ID: {rec['id']}) ---\n"
        display += f"Book Title: {rec['book_title']}\n"
        display += f"Author: {rec['author']}\n"
        display += f"Publisher: {rec['publisher']}\n"
        display += f"Borrow Date: {rec['borrow_date']}\n"
        display += f"Return Date: {rec['return_date']}\n"
        display += f"Borrowing Period: {rec['borrowing_period']} days\n"
        display += f"Overdue Days: {rec['overdue_days']}\n"
        display += f"Late Fee Per Day: ${rec['late_fee_per_day']:.2f}\n"
        book_info = [bk for bk in books if bk['title'].lower() == rec['book_title'].lower()
                     and bk['author'].lower() == rec['author'].lower()]
        if book_info:
            bk = book_info[0]
            display += f"Additional Info: Price=${bk['price']:.2f}, Year={bk['year']}, Category={bk['category']}\n"
        display += "-" * 40 + "\n"
    borrowed_text.delete(1.0, END)
    borrowed_text.insert(END, display)

def compute_late_fees():
    overdue_str = entry_fee_overdue.get()
    fee_str = entry_fee_per_day.get()
    if not overdue_str or not fee_str:
        messagebox.showerror("Error", "Please enter Overdue Days and Late Fee Per Day")
        return
    try:
        overdue = int(overdue_str)
        fee = float(fee_str)
    except:
        messagebox.showerror("Error", "Overdue Days must be integer, Late Fee must be number")
        return
    total = overdue * fee
    result_text = f"Overdue Days: {overdue}\nLate Fee Per Day: ${fee:.2f}\n\nTotal Late Fees: ${total:.2f}\n"
    fees_display_text.delete(1.0, END)
    fees_display_text.insert(END, result_text)

def clear_fee_entries():
    entry_fee_overdue.delete(0, END)
    entry_fee_per_day.delete(0, END)
    fees_display_text.delete(1.0, END)

